pipeline {
  agent any

  triggers {
    // Poll GitHub every 5 minutes for new commits.
    // Use this when Jenkins is behind a firewall and cannot receive webhooks.
    pollSCM('H/5 * * * *')
  }

  options {
    timeout(time: 20, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  tools {
    nodejs 'NodeJS-20'   // must match the name configured in Jenkins → Global Tool Configuration
  }

  environment {
    CI = 'true'
    // Prevent react-scripts from opening a browser during tests
    BROWSER = 'none'
  }

  // Only run the pipeline when a commit lands on main or develop.
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install') {
      steps {
        dir('frontend') {
          sh 'npm ci'
        }
      }
    }

    stage('Lint') {
      steps {
        dir('frontend') {
          sh 'npm run lint'
        }
      }
    }

    stage('Test') {
      steps {
        dir('frontend') {
          sh 'npm test'
        }
      }
    }

    stage('Build') {
      steps {
        dir('frontend') {
          sh 'npm run build'
        }
      }
    }

    stage('Deploy') {
      steps {
        dir('frontend') {
          sh '''
            # Reload if process already exists, otherwise start fresh
            if pm2 describe todo-frontend > /dev/null 2>&1; then
              pm2 restart todo-frontend --update-env
            else
              pm2 serve build 3000 --name todo-frontend --spa
            fi
            pm2 save
          '''
        }
      }
    }
  }

  post {
    failure {
      echo 'Frontend pipeline failed.'
    }
    success {
      echo 'Frontend pipeline passed.'
    }
  }
}
