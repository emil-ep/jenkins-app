pipeline {
  agent any

  triggers {
    // Poll GitHub every 5 minutes for new commits.
    // Use this when Jenkins is behind a firewall and cannot receive webhooks.
    pollSCM('H/5 * * * *')
  }

  options {
    timeout(time: 20, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  tools {
    nodejs 'NodeJS-20'   // must match the name configured in Jenkins → Global Tool Configuration
  }

  environment {
    CI = 'true'
    // Prevent react-scripts from opening a browser during tests
    BROWSER = 'none'
  }

  // Only run the pipeline when a commit lands on main or develop.
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install') {
      steps {
        dir('frontend') {
          sh 'npm ci'
        }
      }
    }

    stage('Lint') {
      steps {
        dir('frontend') {
          sh 'npm run lint'
        }
      }
    }

    stage('Test') {
      steps {
        dir('frontend') {
          sh 'npm test'
        }
      }
    }

    stage('Build') {
      steps {
        dir('frontend') {
          sh 'npm run build'
        }
      }
    }

    stage('Frontend service update') {
      steps {
        script {
          env.DEPLOY_VERSION   = sh(script: 'node -p "require(\'./frontend/package.json\').version"', returnStdout: true).trim()
          env.COMMIT_ID        = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
          env.COMMIT_AUTHOR_TS = sh(script: 'git show -s --format=%aI HEAD', returnStdout: true).trim()
          env.COMMIT_COMMIT_TS = sh(script: 'git show -s --format=%cI HEAD', returnStdout: true).trim()
        }
        dir('frontend') {
          sh '''
            # Kill any existing frontend process on port 3000
            fuser -k 3000/tcp || true

            # Serve the React build in background, detached from this shell
            nohup npx serve -s build -l 3000 > /var/lib/jenkins/logs/todo-frontend.log 2>&1 &
            echo $! > /var/lib/jenkins/pids/todo-frontend.pid
            echo "Frontend started with PID $(cat /var/lib/jenkins/pids/todo-frontend.pid)"
          '''
        }
        script {
          env.DEPLOYED_AT = sh(script: 'date -u +%Y-%m-%dT%H:%M:%SZ', returnStdout: true).trim()
        }
        echo "INSTANA_CD_STAGE=deploy"
        echo "INSTANA_DEPLOY_VERSION=${env.DEPLOY_VERSION}"
        echo "INSTANA_DEPLOY_SERVICE=todo-frontend"
        echo "INSTANA_DEPLOY_ENVIRONMENT=production"
        echo "INSTANA_CD_COMMIT=${env.COMMIT_ID}"
        echo "INSTANA_CD_COMMIT_AUTHOR_TS=${env.COMMIT_AUTHOR_TS}"
        echo "INSTANA_CD_COMMIT_COMMITTER_TS=${env.COMMIT_COMMIT_TS}"
        echo "INSTANA_CD_DEPLOYED_AT=${env.DEPLOYED_AT}"
      }
    }
  }

  post {
    failure {
      echo 'Frontend pipeline failed.'
    }
    success {
      echo 'Frontend pipeline passed.'
    }
  }
}