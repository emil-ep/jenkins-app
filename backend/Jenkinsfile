pipeline {
  agent any

  triggers {
    // Poll GitHub every 5 minutes for new commits.
    // Use this when Jenkins is behind a firewall and cannot receive webhooks.
    pollSCM('H/5 * * * *')
  }

  options {
    timeout(time: 15, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  tools {
    nodejs 'NodeJS-20'   // must match the name configured in Jenkins → Global Tool Configuration
  }

  environment {
    CI = 'true'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install') {
      steps {
        dir('backend') {
          sh 'npm ci'
        }
      }
    }

    stage('Lint') {
      steps {
        dir('backend') {
          sh 'npm run lint'
        }
      }
    }

    stage('Test') {
      steps {
        dir('backend') {
          sh 'npm test'
        }
      }
    }

    stage('Build') {
      steps {
        dir('backend') {
          // The backend has no compile step; validate the entry point loads cleanly
          sh "node -e 'require(\"./src/app\")'"
        }
      }
    }
  }

  post {
    failure {
      echo 'Backend pipeline failed.'
    }
    success {
      echo 'Backend pipeline passed.'
    }
  }
}
