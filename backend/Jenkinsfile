pipeline {
  agent any

  triggers {
    // Poll GitHub every 5 minutes for new commits.
    // Use this when Jenkins is behind a firewall and cannot receive webhooks.
    pollSCM('H/5 * * * *')
  }

  options {
    timeout(time: 15, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  tools {
    nodejs 'NodeJS-20'   // must match the name configured in Jenkins → Global Tool Configuration
  }

  environment {
    CI = 'true'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install') {
      steps {
        dir('backend') {
          sh 'npm ci'
        }
      }
    }

    stage('Lint') {
      steps {
        dir('backend') {
          sh 'npm run lint'
        }
      }
    }

    stage('Test') {
      steps {
        dir('backend') {
          sh 'npm test'
        }
      }
    }

    stage('Build') {
      steps {
        dir('backend') {
          // The backend has no compile step; validate the entry point loads cleanly
          sh "node -e 'require(\"./src/app\")'"
        }
      }
    }

    stage('Backend service update') {
      steps {
        script {
          env.DEPLOY_VERSION = sh(script: 'node -p "require(\'./backend/package.json\').version"', returnStdout: true).trim()
        }
        echo "INSTANA_CD_STAGE=deploy"
        echo "INSTANA_DEPLOY_VERSION=${env.DEPLOY_VERSION}"
        echo "INSTANA_DEPLOY_SERVICE=todo-backend"
        echo "INSTANA_DEPLOY_ENVIRONMENT=production"
        dir('backend') {
          sh '''
            # Kill any existing backend process on port 3001
            fuser -k 3001/tcp || true

            # Start backend in background, detached from this shell
            nohup node src/index.js > /var/lib/jenkins/logs/todo-backend.log 2>&1 &
            echo $! > /var/lib/jenkins/pids/todo-backend.pid
            echo "Backend started with PID $(cat /var/lib/jenkins/pids/todo-backend.pid)"
          '''
        }
      }
    }
  }

  post {
    failure {
      echo 'Backend pipeline failed.'
    }
    success {
      echo 'Backend pipeline passed.'
    }
  }
}
